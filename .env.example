# Supabase connection (client-side, safe to expose — the publishable/anon key
# is protected by Row Level Security). Copy this file to `.env` and fill in
# your own project's values, or set them as environment variables on your
# hosting platform.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Finance in Action v3.1 preview: "true" builds the new viewer with its SYNTHETIC
# fixtures. Leave unset for production; the build fails if it is set on a Vercel
# production build (scripts/assert-no-synthetic.mjs).
# VITE_FIA_PREVIEW="true"

# Finance in Action in production: "true" builds the viewer over the PUBLISHED
# packages only (fia.model_packages: the FSRE channel and the manual one), with
# no fixture in the bundle.
# Production sets it now, with VITE_FIA_PREVIEW unset (owner decision D12(a),
# docs/DECISIONS.md 2026-10-10); until the first package is approved the page
# lists the slate as planned. Never together with VITE_FIA_PREVIEW: the build
# fails.
# VITE_FIA_LIVE="true"

# Kawasan Industri world: "true" builds the living world behind the chain map's
# slot (landing page, About page, /finance/kawasan). Off by default; production
# stays off until the owner turns it on (docs/world/PRD-kawasan-industri.md §7.1).
# VITE_WORLD_KAWASAN="true"

# The manual channel's scripts (scripts/fia/publish-manual.ts, scripts/fia/run-sql.ts)
# read these from .env.local ONLY, never from .env or the environment, and print
# neither. Server-side secrets: never prefix them with VITE_, never commit them.
# Runbook: docs/company-models/two-gates/RUNBOOK.md.
# SUPABASE_DB_URL="postgresql://postgres.your-project-id@aws-0-<region>.pooler.supabase.com:5432/postgres"
# SUPABASE_DB_PASSWORD="your-database-password"
