# Keep checkout bytes identical across platforms: a test pins the sha256 of
# the share-card font licence, and a CRLF checkout breaks it.
scripts/og-fonts/*.txt text eol=lf
scripts/og-fonts/*.ttf binary
# The working paper's source workbook: the published JSON pins its sha256.
docs/consolidation/source/*.xlsx binary
# Rebuilt byte for byte from that workbook by npm run build:workbook.
public/consolidation/*.json text eol=lf
docs/consolidation/build-report.md text eol=lf
# The audited source statements (data/fs/<company>/<period>/source.pdf); each
# folder's README records the file's sha256.
data/fs/**/*.pdf binary
